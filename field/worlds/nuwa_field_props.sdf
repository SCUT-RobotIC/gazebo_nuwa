<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="nuwa_field">
    <!-- ★ 完整场地：含比赛用品（方块/塔顶/五色石），步长 2ms（RTF≈0.99）
         用途：建塔检测、完整任务流程演示 -->
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <!-- DART 的默认碰撞检测器 ode 不支持射线投射（Raycast is not
           supported by 'ode'），而 mid360_sim 插件逐点做物理射线投射。
           bullet 检测器支持 raycast，且对本场地的 box/mesh 都适用 ✓ -->
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.35 0.40 0.45 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.35 0.25 -0.9</direction>
    </light>
    <model name="field">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <!-- 贴地色块 -->
