{
  /*** Sensor configurations ***/
  //
  // ★★★ 这是给【Gazebo 仿真】用的版本，不是真机的 ★★★
  //     真机那份在 ~/SCUT-RobotIC-BeHaviorTree_R1.ROS2/src/localization/glim/config/
  //
  // --- IMU config ---
  // imu_acc_noise / imu_gyro_noise / imu_int_noise / imu_bias_noise
  //     连续时间噪声密度。2026-10-20 已按实机 bag /data/bags/mid360_static_01
  //     对齐：实机 IMU 静态噪声约 0.0022 rad/s、0.073 m/s²，零偏约 0.01 rad/s；
  //     这四个值现在与 rc2026_ros2_ws/maps/config/config_sensors.json 一致 ✓
  //     ⚠ 这是【调优旋钮】，要改先想清楚改的是仿真还是实机那份。
  //
  // --- LiDAR config ---
  // global_shutter_lidar        : If true, fill per-point timestamps with zero and disable points deskewing
  // T_lidar_imu                 : LiDAR-IMU transformation (TUM 格式 [x,y,z,qx,qy,qz,qw])
  //                               定义：p_lidar = T_lidar_imu * p_imu
  // intensity_field / ring_field: 从 PointCloud2 里取强度 / 圈号的字段名
  //
  // --- LiDAR per-point time settings ---
  // autoconf_perpoint_times     : If true, automatically configure per-point timestamps
  // perpoint_relative_time      : 逐点时间是相对帧时间戳还是绝对时间
  // perpoint_time_scale         : 1.0 = 秒，1e-9 = 纳秒
  //
  // --- Camera config (only used in extension modules) ---
  // 仿真里没有相机，这一段原样留着，不影响。
  //
  // --- Transformation format ---
  // SE3 poses are written in the TUM format [x, y, z, qx, qy, qz, qw]
  // "T_lidar_imu" transforms points in the "imu" frame into the "lidar" frame
  // e.g., p_lidar = T_lidar_imu * p_imu, T_world_imu = T_world_lidar * T_lidar_imu
  "sensors": {
    // IMU config
    "imu_acc_noise": 0.05,
    "imu_gyro_noise": 0.02,
    "imu_int_noise": 0.001,
    "imu_bias_noise": 1e-5,

    // LiDAR config
    // ⚠⚠ 仿真现在由 robots/src/mid360_sim 的 gz-sim 系统插件提供点云：
    //     它回放 Mid-360 实测的非重复扫描轨迹，并且【逐点】做物理射线投射，
    //     每点带一个 t 字段（相对帧头，单位秒，0 ~ 0.099995 s）。
    //
    //   ⇒ global_shutter_lidar 必须为 false ✗
    //     设成 true 的话 cloud_preprocessor.cpp:138 会把逐点时间全部清零，
    //     刚补好的真实扫描时序就被丢掉了，运动去畸变随之关闭 ✗
    //
    //   ⇒ perpoint_relative_time = true, perpoint_time_scale = 1.0
    //     插件发的 t 是"相对帧时间戳的秒数"，正好对上这两个设置 ✓
    //
    //   ⚠ 不要再搭配 add_point_time.py —— 它按机械旋转雷达的方位角公式
    //     t=(az+π)/(2π)×period 编时间，对非重复扫描是错的，而且会在点云里
    //     再加一个 t 字段。插件已经给对了，直接桥接 /mid360/points 即可 ✓
    "global_shutter_lidar": false,

    // [仿真] imu 在 base_link 上方 0.30，雷达在上方 0.40，都是 fixed joint、无旋转
    //   => 四元数是单位 [0,0,0,1]，只剩平移 (0.30 - 0.40) = -0.10
    //   自检：我们 launch 里两条静态 TF 是
    //         base_link -> mini_car/base_link/imu     z=+0.30
    //         base_link -> mini_car/base_link/mid360  z=+0.40
    //         两者之差 = 0.10，且 imu 在下 —— 和这里的 -0.10 自洽 ✓
    //   真机那份是 Ouster OS0 的值 [0.006,-0.012,0.008,0,0,0,1]，别抄 ✗
    "T_lidar_imu": [0.0, 0.0, -0.10, 0.0, 0.0, 0.0, 1.0],

    "intensity_field": "intensity",
    // [仿真] mid360_sim 插件同时发 line 和 ring（两者都是 0~3）。
    //   真机驱动是 line 字段（PointXYZRTLT），这里用 ring 兼容现有配置 ✓
    "ring_field": "ring",

    // LiDAR per-point time settings
    // [仿真] 显式声明，不靠 GLIM 自动探测：
    //   插件发的 t 已经是"相对帧头的秒数"（0 ~ 0.099995），
    //   所以 relative_time=true、scale=1.0 直接对上 ✓
    "autoconf_perpoint_times": false,
    "autoconf_prefer_frame_time": false,
    "perpoint_relative_time": true,
    "perpoint_time_scale": 1.0,

    // Camera config (required for only extension modules)
    // 仿真没有相机，原样保留
    "global_shutter_camera": true,
    "image_size": [
      752,
      480
    ],
    "T_lidar_camera": [
      -0.00320,
      -0.05292,
      0.00108,
      0.00837,
      0.72559,
      -0.00328,
      0.68807
    ],
    "intrinsics": [
      815.498895336274,
      817.4904316140473,
      830.3149255906893,
      639.4531613962971
    ],
    "distortion_model": "plumb_bob",
    "distortion_coeffs": [
      -0.02295507941388206,
      0.0681131726659881,
      -0.0005798510962983399,
      0.00128686963241809,
      -0.03279627881588615
    ]
  }
}
