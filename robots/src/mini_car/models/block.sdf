<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="block">
    <static>false</static>

    <link name="link">
      <collision name="col">
        <geometry><box><size>0.35 0.35 0.35</size></box></geometry>
      </collision>

      <visual name="vis">
        <geometry><box><size>0.35 0.35 0.35</size></box></geometry>
        <material>
          <ambient>0.87 0.13 0.13 1</ambient>
          <diffuse>0.87 0.13 0.13 1</diffuse>
        </material>
      </visual>

      <inertial>
        <mass>0.25</mass>
        <!-- 注意：SDF 的惯量是【子元素】，不是 URDF 那样的属性 -->
