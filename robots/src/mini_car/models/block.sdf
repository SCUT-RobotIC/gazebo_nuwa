          <ixx>0.005104</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005104</iyy>
          <iyz>0</iyz>
          <izz>0.005104</izz>
        </inertia>
      </inertial>
    </link>

  </model>
</sdf>
